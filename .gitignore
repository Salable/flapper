node_modules/
.DS_Store
dist/

# Raw screen recordings. The optimised GIF in docs/ is what ships.
*.mov

# The designer's source tile art: 76 MB of per-transition GIFs. The app no
# longer loads anything built from them (tiles are drawn from theme packs);
# tools/build_icon.py still reads them for the desktop app icon.
A-Z 0-9 /

# Personal Claude Code permissions; .claude/settings.json is the shared one.
.claude/settings.local.json

# Next.js / Vercel
# next-env.d.ts is generated, says so in its own header, and Next rewrites it
# depending on whether you last ran dev or build - the import flips between
# .next/dev/types and .next/types. Tracked, that meant the working tree went
# dirty every time you switched between the two. tsconfig lists it but does
# not need it: typecheck passes on a clean checkout with neither this file nor
# .next present, which is exactly what CI does (npm ci, then typecheck, with
# no build in that job).
next-env.d.ts
.next/
.vercel
.env*.local
.pglite/

# TypeScript incremental build cache
tsconfig.tsbuildinfo
