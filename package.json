{
  "name": "flapper",
  "productName": "Flapper",
  "version": "4.0.0",
  "description": "A split-flap board for the web: create a board, put it on a wall, drive it over REST.",
  "license": "MIT",
  "homepage": "https://github.com/Salable/flapper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salable/flapper.git"
  },
  "bugs": {
    "url": "https://github.com/Salable/flapper/issues"
  },
  "keywords": [
    "split-flap",
    "flipboard",
    "nextjs",
    "vercel",
    "canvas",
    "departure-board",
    "wall-display"
  ],
  "author": "Salable",
  "scripts": {
    "dev": "next dev",
    "build": "node tools/migrate-if-db.mjs && next build",
    "db:generate": "drizzle-kit generate",
    "start": "next start",
    "build:assets": "python3 tools/build_assets.py",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/redis": "^1.34.9",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.10",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.32.2",
    "typescript": "^5.7.0"
  },
  "private": false,
  "engines": {
    "node": ">=20.11"
  }
